# Sentinel Environment Variables Configuration
# Copy this file to '.env' and set your values.
# DO NOT commit '.env' to git.

# Administrator credentials. They are synchronized to the existing admin on
# startup, so changing either value is also the recovery/reset mechanism.
ADMIN_LOGIN=admin
ADMIN_NAME=Sentinel Admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Use true only when Sentinel is served through HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL=12h

# Optional: comma-separated public browser origins. Set this when the reverse
# proxy rewrites Host, for example: https://sentinel.example.com
AUTH_ALLOWED_ORIGINS=

# Keep false unless requests only arrive from a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Optional: count only these host interfaces. Leave empty to aggregate every
# interface returned by the OS (which can include loopback, bridges and veths).
NETWORK_INTERFACES=

# Optional Docker Engine telemetry. Prefer a protected read-only HTTP proxy.
# Direct socket access is supported, but mounting docker.sock grants highly
# privileged control over the host and is intentionally not in docker-compose.
CONTAINER_METRICS_ENABLED=false
CONTAINER_API_URL=
DOCKER_SOCKET=/var/run/docker.sock
