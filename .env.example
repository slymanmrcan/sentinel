# Sentinel Environment Variables Configuration
# Copy this file to '.env' and set your values.
# DO NOT commit '.env' to git.

# Administrator credentials. They are synchronized to the existing admin on
# startup, so changing either value is also the recovery/reset mechanism.
ADMIN_LOGIN=admin
ADMIN_NAME=Sentinel Admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Use true only when Sentinel is served through HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL=12h

# Optional: comma-separated public browser origins. Set this when the reverse
# proxy rewrites Host, for example: https://sentinel.example.com
AUTH_ALLOWED_ORIGINS=

# Keep false unless requests only arrive from a trusted reverse proxy.
# For a single Nginx Proxy Manager hop, use true so login limits use the
# connecting client's IP instead of sharing NPM's IP. The rightmost
# X-Forwarded-For entry is used. With a CDN before NPM, verify real-IP handling
# in NPM first. Direct access must be restricted to trusted callers.
TRUST_PROXY_HEADERS=false

# Optional: count only these host interfaces. Leave empty to aggregate every
# interface returned by the OS (which can include loopback, bridges and veths).
NETWORK_INTERFACES=

# Optional Docker Engine telemetry. Prefer a protected read-only HTTP proxy.
# Direct socket access is supported, but mounting docker.sock grants highly
# privileged control over the host. The current Compose file mounts the socket;
# remove that mount if you switch to a restricted HTTP proxy.
CONTAINER_METRICS_ENABLED=false
CONTAINER_COLLECTION_INTERVAL=15s
CONTAINER_API_URL=
DOCKER_SOCKET=/var/run/docker.sock

# Optional systemd service status and recent journal entries. Only explicitly
# listed .service units are queried; no service-control action is exposed.
SYSTEMD_UNITS=fail2ban.service,ssh.service
SYSTEMD_LOG_LINES=8

# Optional Telegram notifications. Server-side secrets; never shown in the UI.
# Disabled means no Telegram workers, SSH journal polling or Telegram traffic.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Numeric chat ID (negative for groups). Start a conversation with your bot first.
TELEGRAM_TIMEZONE=Europe/Istanbul
TELEGRAM_SUMMARY_TIMES=09:00,15:00,21:00
# For two daily summaries: 09:00,21:00. Empty disables scheduled summaries.
# Existing DuckDB alert_rules provide CPU/RAM/disk/swap high thresholds.
# Hold applies to both alarm and recovery; margin is percentage points.
TELEGRAM_ALERT_HOLD=2m
TELEGRAM_RECOVERY_MARGIN=5
# Observed rejected Sentinel logins, including requests rejected by IP lockout.
TELEGRAM_BRUTE_WINDOW=5m
TELEGRAM_BRUTE_THRESHOLD=5
# Opt-in: OpenSSH failed password/publickey records from system journal only.
# Needs journalctl and permission to read system ssh.service/sshd.service logs.
TELEGRAM_SSH_ENABLED=false
